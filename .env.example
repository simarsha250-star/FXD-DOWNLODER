# Optional. Only needed for Instagram and Facebook link previews (Meta oEmbed Read).
# Requires a Meta developer app that Meta has approved for the "Meta oEmbed Read" feature.
# Format: APP_ID|APP_SECRET (an app access token) or a client token, as Meta documents it.
# Set it in Vercel > Project > Settings > Environment Variables. Never put it in src/.
META_OEMBED_TOKEN=

# Optional. Graph API version for the Meta endpoints, for example v23.0.
# Leave empty to call the unversioned endpoint, which Meta maps to your app's default version.
META_GRAPH_VERSION=
